<Application x:Class="TicaretYonetim.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources>
                    <ui:ThemeResources.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="#2E7D32"/>
                            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EDF1EC"/>
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FAFBF9"/>
                            <SolidColorBrush x:Key="CardBorderBrush" Color="#22000000"/>
                            <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6B62"/>
                            <SolidColorBrush x:Key="GridAltBrush" Color="#F1F4F0"/>
                            <SolidColorBrush x:Key="GridHoverBrush" Color="#142E7D32"/>
                            <SolidColorBrush x:Key="GridSelectedBrush" Color="#222E7D32"/>
                            <SolidColorBrush x:Key="AppTextBrush" Color="#182219"/>
                            <SolidColorBrush x:Key="ChartLabelBrush" Color="#374151"/>
                            <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
                            <SolidColorBrush x:Key="InfoBrush" Color="#1565C0"/>
                            <SolidColorBrush x:Key="TealBrush" Color="#00897B"/>
                            <SolidColorBrush x:Key="DangerBrush" Color="#C62828"/>
                            <SolidColorBrush x:Key="OrangeBrush" Color="#EF6C00"/>
                            <SolidColorBrush x:Key="PurpleBrush" Color="#8E24AA"/>
                            <SolidColorBrush x:Key="AmberBrush" Color="#F9A825"/>
                            <SolidColorBrush x:Key="PillBackgroundBrush" Color="#EAF6EC"/>
                            <SolidColorBrush x:Key="InfoPanelBrush" Color="#E8F0FE"/>
                            <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E1E5EB"/>
                            <SolidColorBrush x:Key="SoftPanelBrush" Color="#1A000000"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="#43A047"/>
                            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12161D"/>
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1D232C"/>
                            <SolidColorBrush x:Key="CardBorderBrush" Color="#26FFFFFF"/>
                            <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA5B4"/>
                            <SolidColorBrush x:Key="GridAltBrush" Color="#161C25"/>
                            <SolidColorBrush x:Key="GridHoverBrush" Color="#14FFFFFF"/>
                            <SolidColorBrush x:Key="GridSelectedBrush" Color="#3343A047"/>
                            <SolidColorBrush x:Key="AppTextBrush" Color="#F3F5F8"/>
                            <SolidColorBrush x:Key="ChartLabelBrush" Color="#9AA5B4"/>
                            <SolidColorBrush x:Key="SuccessBrush" Color="#66BB6A"/>
                            <SolidColorBrush x:Key="InfoBrush" Color="#64B5F6"/>
                            <SolidColorBrush x:Key="TealBrush" Color="#4DB6AC"/>
                            <SolidColorBrush x:Key="DangerBrush" Color="#EF5350"/>
                            <SolidColorBrush x:Key="OrangeBrush" Color="#FFA726"/>
                            <SolidColorBrush x:Key="PurpleBrush" Color="#AB47BC"/>
                            <SolidColorBrush x:Key="AmberBrush" Color="#FFCA28"/>
                            <SolidColorBrush x:Key="PillBackgroundBrush" Color="#1E3226"/>
                            <SolidColorBrush x:Key="InfoPanelBrush" Color="#16233A"/>
                            <SolidColorBrush x:Key="ProgressTrackBrush" Color="#2A2F38"/>
                            <SolidColorBrush x:Key="SoftPanelBrush" Color="#1AFFFFFF"/>
                        </ResourceDictionary>
                    </ui:ThemeResources.ThemeDictionaries>
                </ui:ThemeResources>
                <ui:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AccentBrush" Color="#2E7D32"/>
            <SolidColorBrush x:Key="AccentBrushLight" Color="#43A047"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="#151B24"/>
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1F2733"/>
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2E7D32" Offset="0"/>
                <GradientStop Color="#00897B" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#161D29" Offset="0"/>
                <GradientStop Color="#0E141E" Offset="1"/>
            </LinearGradientBrush>
            <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.13" Color="#000000"/>
            <DropShadowEffect x:Key="AccentShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#2E7D32"/>
            <DropShadowEffect x:Key="Glow3DShadow" BlurRadius="30" ShadowDepth="7" Direction="285" Opacity="0.25" Color="#1B5E20"/>

            <Style TargetType="{x:Type Control}" x:Key="{x:Type Control}">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="TitleText">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,20"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="CardTitle">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="CardValue">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="FontSize" Value="27"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <Style TargetType="Border" x:Key="CardStyle">
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,14,14"/>
                <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrushLight}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Border" x:Key="Hero3DCardStyle" BasedOn="{StaticResource CardStyle}">
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Effect" Value="{StaticResource Glow3DShadow}"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <SkewTransform AngleX="-0.9" AngleY="0.35"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Border" x:Key="Icon3DTile">
                <Setter Property="Width" Value="54"/>
                <Setter Property="Height" Value="54"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="Effect" Value="{StaticResource AccentShadow}"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="-4"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Border" x:Key="StatChip">
                <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <LinearGradientBrush x:Key="IconGreenBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#43A047" Offset="0"/><GradientStop Color="#1B5E20" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="IconRedBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EF5350" Offset="0"/><GradientStop Color="#B71C1C" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="IconBlueBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#42A5F5" Offset="0"/><GradientStop Color="#0D47A1" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="IconOrangeBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFA726" Offset="0"/><GradientStop Color="#E65100" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="IconPurpleBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#AB47BC" Offset="0"/><GradientStop Color="#4A148C" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="IconTealBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#26A69A" Offset="0"/><GradientStop Color="#004D40" Offset="1"/>
            </LinearGradientBrush>

            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
            </Style>
            <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
            </Style>

            <Style TargetType="Button" x:Key="AccentButtonStyle" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
                <Setter Property="Effect" Value="{StaticResource AccentShadow}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Opacity" Value="0.75"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="RadioButton" x:Key="NavButtonStyle">
                <Setter Property="Foreground" Value="#9FACC2"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="22,13"/>
                <Setter Property="Margin" Value="12,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid" x:Key="ModernDataGridStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeight" Value="42"/>
                <Setter Property="ColumnHeaderHeight" Value="40"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltBrush}"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
                <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GridHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GridSelectedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
