<UserControl x:Class="TicaretYonetim.Views.RaporlarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="Raporlar" Style="{StaticResource TitleText}"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Başlangıç" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding Baslangic}" Margin="0,0,20,0"/>
                    <TextBlock Text="Bitiş" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding Bitis}" Margin="0,0,20,0"/>
                    <Button Content="CSV Dışa Aktar" Command="{Binding DisaAktarCommand}" Padding="12,6"/>
                </StackPanel>

                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Toplam Ciro" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ToplamCiro, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Toplam Maliyet" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ToplamMaliyet, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}" Foreground="#C62828"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Kâr" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ToplamKar, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <DataGrid ItemsSource="{Binding UrunRaporu}" AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="420" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ürün" Binding="{Binding UrunAdi}" Width="*"/>
                        <DataGridTextColumn Header="Satılan Adet" Binding="{Binding SatilanAdet}" Width="120"/>
                        <DataGridTextColumn Header="Ciro" Binding="{Binding ToplamCiro, StringFormat={}{0:N2} ₺}" Width="120"/>
                        <DataGridTextColumn Header="Maliyet" Binding="{Binding ToplamMaliyet, StringFormat={}{0:N2} ₺}" Width="120"/>
                        <DataGridTextColumn Header="Kâr" Binding="{Binding Kar, StringFormat={}{0:N2} ₺}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
