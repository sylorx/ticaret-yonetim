<UserControl x:Class="TicaretYonetim.Views.YedeklemeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <TextBlock Text="💾 Yedekleme ve Geri Yükleme" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Tüm verileriniz (ürünler, satışlar, alışlar, filamentler, sohbet geçmişi ve resimler) tek dosyada yedeklenir. Bir şey olursa tek tıkla geri getirin."
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,-10,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🛡️ Yedek Oluştur" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Veritabanının anlık güvenli kopyasını alır. Son 10 yedek otomatik tutulur, eskileri silinir."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Button Content="➕ Yeni Yedek Oluştur" Command="{Binding YedekOlusturCommand}"
                                Style="{StaticResource AccentButtonStyle}" Padding="16,8" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📦 Dışa / İçe Aktar" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Tüm verileri + resimleri tek ZIP dosyasına aktarır. Başka bilgisayara taşımak veya kalıcı arşiv için idealdir."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⬇ Dışa Aktar (ZIP)" Command="{Binding DisariAktarCommand}" Padding="14,8"/>
                            <Button Content="⬆ İçe Aktar (ZIP)" Command="{Binding IceriAktarCommand}" Padding="14,8" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,14,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🗂 Yedeklerim" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Durum}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid Style="{StaticResource ModernDataGridStyle}" ItemsSource="{Binding Yedekler}" SelectedItem="{Binding Secili}"
                              AutoGenerateColumns="False" IsReadOnly="True" Height="300" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Yedek Adı" Binding="{Binding Ad}" Width="*"/>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Boyut" Binding="{Binding Boyut}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="♻ Geri Yükle" Command="{Binding GeriYukleCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8"/>
                        <Button Content="🗑 Sil" Command="{Binding YedekSilCommand}" Padding="16,8" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource InfoPanelBrush}" CornerRadius="10" Padding="14" Margin="0,14,14,0">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InfoBrush}">
                    <Run Text="💡 " FontWeight="Bold"/>
                    <Run Text="Otomatik yedek: Program her açılışta, son yedek 24 saatten eskiyse kendiliğinden yedek alır. Ayrıca içe aktarma ve geri yükleme öncesinde mevcut verileriniz güvenlik için otomatik yedeklenir — hiçbir işlem verilerinizi geri dönülemez şekilde silmez."/>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
