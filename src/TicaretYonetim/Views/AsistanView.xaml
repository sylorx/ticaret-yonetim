<UserControl x:Class="TicaretYonetim.Views.AsistanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🤖 Yapay Zeka Asistanı" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Durum}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Model" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                    <ComboBox ItemsSource="{Binding Modeller}" SelectedItem="{Binding SeciliModel}" Width="190" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Bağlam (mesaj sayısı)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                    <ComboBox SelectedItem="{Binding ContextMesajSayisi}" Width="120" Margin="0,4,0,0">
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Bottom">
                    <CheckBox Content="Veri bağlamını dahil et" IsChecked="{Binding VeriBaglamiDahil}" Margin="0,0,0,6"/>
                    <Button Content="🔄 Modelleri Yenile" Command="{Binding ModelleriYenileCommand}" Padding="10,4" FontSize="12"/>
                </StackPanel>
                <Button Content="🗑 Temizle" Command="{Binding TemizleCommand}" Padding="10,4" FontSize="12" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Expander Header="⚙️ Ollama Kaynak Ayarları (RAM / GPU / CPU)" IsExpanded="False" Margin="0,0,0,8">
                    <Border Background="{DynamicResource SoftPanelBrush}" CornerRadius="10" Padding="14" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Ollama'nın bilgisayarınızın hangi kaynaklarını ne kadar kullanacağını seçin. Seçimleriniz hatırlanır ve 'Kaydet ve Yeniden Başlat' ile hemen uygulanır."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="GPU Kullanımı" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding GpuModuSecenekleri}" SelectedItem="{Binding Ayar.GpuModu}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bağlam (RAM, token)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding ContextSecenekleri}" SelectedItem="{Binding Ayar.ContextLength}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="KV Cache (RAM)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding KvCacheSecenekleri}" SelectedItem="{Binding Ayar.KvCacheTipi}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Paralel İstek (CPU)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding ParalelSecenekleri}" SelectedItem="{Binding Ayar.ParalelIstek}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Aynı Anda Yüklü Model" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding MaxModelSecenekleri}" SelectedItem="{Binding Ayar.MaxYukluModel}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Model Bellekte Kalma" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding KeepAliveSecenekleri}" SelectedItem="{Binding Ayar.KeepAlive}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="GPU'da Ayrılacak VRAM Payı (MB, 0=otomatik)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ComboBox SelectedItem="{Binding Ayar.GpuOverheadMb}" Margin="0,4,0,0">
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="512"/>
                                        <ComboBoxItem Content="1024"/>
                                        <ComboBoxItem Content="2048"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Model Yükleme Süresi (saniye)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ComboBox SelectedItem="{Binding Ayar.LoadTimeoutSaniye}" Margin="0,4,0,0">
                                        <ComboBoxItem Content="300"/>
                                        <ComboBoxItem Content="600"/>
                                        <ComboBoxItem Content="900"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding AyarDurumu}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="💾 Kaydet ve Ollama'yı Yeniden Başlat" Command="{Binding AyarKaydetCommand}"
                                        Style="{StaticResource AccentButtonStyle}" Padding="14,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>
                <ScrollViewer Grid.Row="1" x:Name="SohbetKaydirici" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding Mesajlar}" Margin="4" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Balon" MaxWidth="620" CornerRadius="16" Padding="14,10"
                                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            HorizontalAlignment="Left" Effect="{StaticResource CardShadow}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <Run Text="🤖 Asistan"/>
                                                    <Run Text="{Binding Tarih, StringFormat=· {0:HH:mm}}" Foreground="{DynamicResource MutedTextBrush}"/>
                                                </TextBlock>
                                                <Button Grid.Column="1" Click="Kopyala_Click" Tag="{Binding Icerik}" ToolTip="Mesajı kopyala"
                                                        Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                                        FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="📋 Kopyala" FontSize="11"/>
                                                </Button>
                                            </Grid>
                                            <TextBox x:Name="BalonMetni" Text="{Binding Icerik}" IsReadOnly="True" TextWrapping="Wrap"
                                                     FontSize="14" BorderThickness="0" Background="Transparent" Padding="0"
                                                     IsInactiveSelectionHighlightEnabled="True" FocusVisualStyle="{x:Null}"
                                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Disabled">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                                        <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}"/>
                                                        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrushLight}"/>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Rol}" Value="user">
                                        <Setter TargetName="Balon" Property="Grid.Column" Value="1"/>
                                        <Setter TargetName="Balon" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Balon" Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                                        <Setter TargetName="Balon" Property="BorderBrush" Value="{StaticResource AccentGradientBrush}"/>
                                        <Setter TargetName="Balon" Property="Effect" Value="{StaticResource AccentShadow}"/>
                                        <Setter TargetName="Balon" Property="TextElement.Foreground" Value="White"/>
                                        <Setter TargetName="BalonMetni" Property="Foreground" Value="White"/>
                                        <Setter TargetName="BalonMetni" Property="SelectionBrush" Value="#66FFFFFF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MesajKutusu" Text="{Binding GirilenMesaj, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="48" Padding="12,10" FontSize="14"
                     VerticalContentAlignment="Center"
                     KeyDown="MesajKutusu_KeyDown"
                     ToolTip="Sorunuzu yazın ve Enter'a basın. Örn: 'Bu ay ne kadar kar ettik?'"/>
            <Button Grid.Column="1" Content="Gönder ➤" Command="{Binding GonderCommand}"
                    Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0" Padding="22,10" FontSize="14"/>
        </Grid>
    </Grid>
</UserControl>
