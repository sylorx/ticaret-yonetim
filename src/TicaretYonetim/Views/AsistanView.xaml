<UserControl x:Class="TicaretYonetim.Views.AsistanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🤖 Yapay Zeka Asistanı" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Durum}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Model" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                    <ComboBox ItemsSource="{Binding Modeller}" SelectedItem="{Binding SeciliModel}" Width="190" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Bağlam (mesaj sayısı)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                    <ComboBox SelectedItem="{Binding ContextMesajSayisi}" Width="120" Margin="0,4,0,0">
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Bottom">
                    <CheckBox Content="Veri bağlamını dahil et" IsChecked="{Binding VeriBaglamiDahil}" Margin="0,0,0,6"/>
                    <Button Content="🔄 Modelleri Yenile" Command="{Binding ModelleriYenileCommand}" Padding="10,4" FontSize="12"/>
                </StackPanel>
                <Button Content="🗑 Temizle" Command="{Binding TemizleCommand}" Padding="10,4" FontSize="12" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <ScrollViewer x:Name="SohbetKaydirici" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Mesajlar}" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Balon" MaxWidth="620" CornerRadius="14" Padding="14,10"
                                        Background="#1D232C" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="#8FA1B3" FontWeight="SemiBold" Margin="0,0,0,4">
                                            <Run Text="🤖 Asistan"/>
                                            <Run Text="{Binding Tarih, StringFormat=· {0:HH:mm}}" Foreground="#5A6B7C"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Icerik}" TextWrapping="Wrap" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Rol}" Value="user">
                                    <Setter TargetName="Balon" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="Balon" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Balon" Property="Background" Value="#2E7D32"/>
                                    <Setter TargetName="Balon" Property="BorderBrush" Value="#43A047"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MesajKutusu" Text="{Binding GirilenMesaj, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="48" Padding="12,10" FontSize="14"
                     VerticalContentAlignment="Center"
                     KeyDown="MesajKutusu_KeyDown"
                     ToolTip="Sorunuzu yazın ve Enter'a basın. Örn: 'Bu ay ne kadar kar ettik?'"/>
            <Button Grid.Column="1" Content="Gönder ➤" Command="{Binding GonderCommand}"
                    Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0" Padding="22,10" FontSize="14"/>
        </Grid>
    </Grid>
</UserControl>
