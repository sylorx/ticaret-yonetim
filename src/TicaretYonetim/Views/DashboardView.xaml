<UserControl x:Class="TicaretYonetim.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TicaretYonetim.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <TextBlock Text="Genel Durum" Style="{StaticResource TitleText}"/>

            <UniformGrid Columns="3" Rows="1">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="#2E7D32" VerticalAlignment="Center">
                            <TextBlock Text="💰" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Toplam Satış Cirosu" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ToplamSatisTutari, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="#C62828" VerticalAlignment="Center">
                            <TextBlock Text="🧾" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Toplam Alış Gideri" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ToplamAlisTutari, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}" Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="#1565C0" VerticalAlignment="Center">
                            <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Net Kâr" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding NetKar, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}" Foreground="{DynamicResource InfoBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="3" Rows="1" Margin="0,4,0,0">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="#EF6C00" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Bu Ay Satış" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding BuAySatis, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}" Foreground="{DynamicResource OrangeBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="#6A1B9A" VerticalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Ortalama Kâr Marjı" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding OrtalamaKarMarji, StringFormat={}%{0:N1}}" Style="{StaticResource CardValue}" Foreground="{DynamicResource PurpleBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="#00897B" VerticalAlignment="Center">
                            <TextBlock Text="🧵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Kalan Filament" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding FilamentKalanGram, StringFormat={}{0:N0} g}" Style="{StaticResource CardValue}" Foreground="{DynamicResource TealBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="3" Rows="1" Margin="0,4,0,0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Toplam Satılan Adet" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ToplamSatisAdedi}" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Aktif Ürün Sayısı" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding UrunSayisi}" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Filament Çeşidi" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding FilamentCesidi}" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,12,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Aylık Kazanç Trendi (Ciro · Kâr · Adet — Son 12 Ay)" FontWeight="SemiBold" FontSize="16"/>
                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="10" Padding="10,4">
                            <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold">
                                <Run Text="Kâr: "/><Run Text="{Binding NetKar, StringFormat={}{0:N0} ₺}"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <lvc:CartesianChart Series="{Binding KazancSeries}" XAxes="{Binding KazancXEksen}" YAxes="{Binding KazancYEksen}"
                                        LegendTextPaint="{Binding EtiketPaint}"
                                        TooltipBackgroundPaint="{Binding TooltipZeminPaint}" TooltipTextPaint="{Binding TooltipMetinPaint}"
                                        AnimationsSpeed="00:00:00.450" TooltipPosition="Top"
                                        Height="300" LegendPosition="Top"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Son Hareketler" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <DataGrid Style="{StaticResource ModernDataGridStyle}" ItemsSource="{Binding SonHareketler}" AutoGenerateColumns="False"
                                  IsReadOnly="True" MaxHeight="360" HeadersVisibility="Column" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tür" Binding="{Binding Tur}" Width="70"/>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                                <DataGridTextColumn Header="Ürün / Açıklama" Binding="{Binding UrunAdi}" Width="*"/>
                                <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat={}{0:N2} ₺}" Width="100"/>
                                <DataGridTextColumn Header="Detay" Binding="{Binding Detay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Satış Kanalı Dağılımı" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <lvc:PieChart Series="{Binding KanalSeries}" Height="200" LegendPosition="Bottom" LegendTextPaint="{Binding EtiketPaint}"
                                        TooltipBackgroundPaint="{Binding TooltipZeminPaint}" TooltipTextPaint="{Binding TooltipMetinPaint}"
                                        AnimationsSpeed="00:00:00.450"/>
                        <ItemsControl ItemsSource="{Binding KanalOzeti}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Kategori}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Adet, StringFormat={}Adet: {0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ToplamSatis, StringFormat={}{0:N2} ₺}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,4,12,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Filament Kullanımı" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource MutedTextBrush}">
                            <Run Text="{Binding FilamentHarcananGram, StringFormat={}{0:N0} g harcandı}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding FilamentKalanGram, StringFormat={}{0:N0} g kaldı}"/>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Height="12" Minimum="0" Maximum="100" Value="{Binding FilamentKullanimYuzde, Mode=OneWay}"
                                 Foreground="{DynamicResource AmberBrush}" Background="{DynamicResource ProgressTrackBrush}"/>
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding FilamentKullanimYuzde, StringFormat={}Toplam filamentin %{0:N1} i kullanıldı. Satış yaptıkça ürünlere bağlı filament gramı otomatik düşülür.}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
