<UserControl x:Class="TicaretYonetim.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TicaretYonetim.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Genel Durum" Style="{StaticResource TitleText}"/>

            <UniformGrid Columns="4" Rows="1">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Toplam Satış Cirosu" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ToplamSatisTutari, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Toplam Alış Gideri" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ToplamAlisTutari, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}" Foreground="#C62828"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Net Kâr" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding NetKar, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Bu Ay Satış" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding BuAySatis, StringFormat={}{0:N2} ₺}" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Toplam Satılan Adet" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ToplamSatisAdedi}" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Aktif Ürün Sayısı" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding UrunSayisi}" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Son Hareketler" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding SonHareketler}" AutoGenerateColumns="False"
                                  IsReadOnly="True" MaxHeight="360" HeadersVisibility="Column" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tür" Binding="{Binding Tur}" Width="70"/>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                                <DataGridTextColumn Header="Ürün / Açıklama" Binding="{Binding UrunAdi}" Width="*"/>
                                <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat={}{0:N2} ₺}" Width="100"/>
                                <DataGridTextColumn Header="Detay" Binding="{Binding Detay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Satış Kanalı Dağılımı" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding KanalOzeti}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Kategori}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ToplamSatis, StringFormat={}Ciro: {0:N2} ₺}" Foreground="Gray"/>
                                            <TextBlock Text="{Binding Adet, StringFormat={}Adet: {0}}" Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
