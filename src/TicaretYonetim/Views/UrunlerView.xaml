<UserControl x:Class="TicaretYonetim.Views.UrunlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TicaretYonetim.ViewModels">
    <UserControl.Resources>
        <vm:KucukResimConverter x:Key="KucukResim"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ürünler / Dijital Katalog" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="⬆ CSV İçe Aktar" Command="{Binding IceAktarCommand}"
                        Padding="10,6" VerticalAlignment="Center"
                        ToolTip="CSV sütun sırası: Ad;Açıklama;Tür;Kategori;Birim Maliyet;Satış Fiyatı;Stok Adedi"/>
            </Grid>
            <TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" Padding="8"
                     Tag="Ürün ara..." ToolTip="Ürün adı ile ara"/>

            <ListView ItemsSource="{Binding Urunler}" SelectedItem="{Binding Secili}" BorderThickness="0" Background="Transparent" Height="560"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True" Background="#EEEEEE">
                                    <Image Source="{Binding ResimYolu, Converter={StaticResource KucukResim}, ConverterParameter=128}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Ad}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding Tur}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                        <Run Text="Fiyat: "/><Run Text="{Binding SatisFiyati, StringFormat={}{0:N2} ₺}"/>
                                        <Run Text="  Stok: "/><Run Text="{Binding StokAdedi}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold">
                                        <Run Text="Kâr: "/><Run Text="{Binding KarTutari, Mode=OneWay, StringFormat={}{0:N2} ₺}"/>
                                        <Run Text=" (%"/><Run Text="{Binding KarMarjiYuzde, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=")"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Ürün Detayı" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Border Width="140" Height="140" CornerRadius="10" ClipToBounds="True" Background="#EEEEEE" HorizontalAlignment="Left">
                        <Image Source="{Binding DuzenlenenUrun.ResimYolu, Converter={StaticResource KucukResim}, ConverterParameter=280}" Stretch="UniformToFill"/>
                    </Border>
                    <Button Content="Resim Seç" Command="{Binding ResimSecCommand}" Margin="0,8,0,16" HorizontalAlignment="Left" Padding="10,4"/>

                    <TextBlock Text="Ürün Adı" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DuzenlenenUrun.Ad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6"/>

                    <TextBlock Text="Açıklama" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DuzenlenenUrun.Aciklama, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

                    <TextBlock Text="Ürün Türü" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding TurListesi}" SelectedItem="{Binding DuzenlenenUrun.Tur}" Margin="0,0,0,10" Padding="6"/>

                    <TextBlock Text="Kategori" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DuzenlenenUrun.Kategori, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Birim Maliyet (₺)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DuzenlenenUrun.BirimMaliyet, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Satış Fiyatı (₺)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DuzenlenenUrun.SatisFiyati, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Stok Adedi" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DuzenlenenUrun.StokAdedi, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Filament Kullanımı (gram/adet)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DuzenlenenUrun.FilamentGram, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Varsayılan Filament" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding FilamentSecenekleri}" DisplayMemberPath="Ad" SelectedValuePath="Id"
                                      SelectedValue="{Binding DuzenlenenUrun.FilamentId}" Padding="6"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Kâr Hesabı (Bu Ürün İçin)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="Birim Kâr: " FontWeight="SemiBold"/>
                                <Run Text="{Binding DuzenlenenUrun.KarTutari, Mode=OneWay, StringFormat={}{0:N2} ₺}" FontWeight="Bold"/>
                                <Run Text="  ·  Kâr Marjı: "/>
                                <Run Text="{Binding DuzenlenenUrun.KarMarjiYuzde, Mode=OneWay, StringFormat={}%{0:N1}}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Örnek: Malzeme 400 ₺, satış fiyatı 500 ₺ ise kâr 100 ₺ (%20 marj) olarak burada görünür."/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Yeni" Command="{Binding YeniCommand}" Margin="0,0,8,0" Padding="14,6"/>
                        <Button Content="Sil" Command="{Binding SilCommand}" Margin="0,0,8,0" Padding="14,6"/>
                        <Button Content="Kaydet" Command="{Binding KaydetCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
