<Window x:Class="TicaretYonetim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:TicaretYonetim.ViewModels"
        xmlns:views="clr-namespace:TicaretYonetim.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Ticaret Yönetim - Satış, Alış ve Katalog Takibi" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UrunlerViewModel}">
            <views:UrunlerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SatislarViewModel}">
            <views:SatislarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlislarViewModel}">
            <views:AlislarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RaporlarViewModel}">
            <views:RaporlarView/>
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1B2430">
            <StackPanel Margin="0,24,0,0">
                <TextBlock Text="Ticaret Yönetim" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20,0,0,4"/>
                <TextBlock Text="Web · Katalog · 3D Baskı" Foreground="#8FA1B3" FontSize="12" Margin="20,0,0,24"/>

                <RadioButton Style="{StaticResource NavButtonStyle}" Content="📊  Panel"
                             Command="{Binding NavigateCommand}" CommandParameter="Dashboard" IsChecked="True"/>
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="📦  Ürünler"
                             Command="{Binding NavigateCommand}" CommandParameter="Urunler"/>
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="💰  Satışlar"
                             Command="{Binding NavigateCommand}" CommandParameter="Satislar"/>
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="🧾  Alışlar"
                             Command="{Binding NavigateCommand}" CommandParameter="Alislar"/>
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="📈  Raporlar"
                             Command="{Binding NavigateCommand}" CommandParameter="Raporlar"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <ContentControl Content="{Binding MevcutGorunum}"/>
        </Border>
    </Grid>
</Window>
